# Salin ke .env lalu isi nilainya
PORT=3000
SESSION_SECRET=ganti-dengan-string-acak-panjang-min-32-karakter

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Key di bawah ini adalah TEST KEY resmi Cloudflare — selalu lolos verifikasi.
# Ganti dengan site key & secret key asli dari dashboard Cloudflare untuk produksi.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google OAuth — Login dengan Gmail (https://console.cloud.google.com/apis/credentials)
# Buat "OAuth client ID" tipe Web, tambahkan Authorized JavaScript origin:
#   http://localhost:3000   (dan domain produksi nanti)
# Kosongkan untuk menonaktifkan tombol Google.
GOOGLE_CLIENT_ID=

# Midtrans — Payment Gateway (https://dashboard.midtrans.com / sandbox: https://dashboard.sandbox.midtrans.com)
# Ambil dari Settings → Access Keys. Untuk uji coba, pakai SANDBOX keys.
# Jangan lupa daftarkan Notification URL di dashboard:
#   https://domain-anda/api/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
